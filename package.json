{
  "name": "rvidia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npx prisma generate --schema=frontend/prisma/schema.prisma",
    "build": "npx prisma generate --schema=frontend/prisma/schema.prisma && cd frontend && next build",
    "dev": "cd frontend && next dev",
    "dev:gmail": "cd frontend && cross-env FORCE_GMAIL=true next dev",
    "lint": "cd frontend && next lint",
    "start": "cd frontend && next start",
    "prod": "cd frontend && cross-env NODE_ENV=production next start",
    "build:prod": "cd frontend && cross-env NODE_ENV=production next build",
    "dev:prod": "cd frontend && cross-env NODE_ENV=production next dev"
  },
